---
import '../styles/global.css'
import { Font } from 'astro:assets'
import SiteHeader from '../components/nav/SiteHeader.astro'
import SiteFooter from '../components/nav/SiteFooter.astro'
import ShareMeta from '../components/seo/ShareMeta.astro'
import SiteLoader from '../components/brand/SiteLoader.astro'
import portrait from '../assets/portraits/about.png'
import JsonLd from '../components/seo/JsonLd.astro'
import { disciplines } from '../content/disciplines'
import { person } from '../content/person'
import { analytics } from '../content/analytics'
import { BLOG_FEED_TITLE } from '../lib/blog'
import { beacon } from '../lib/analytics'
import { pageTitle } from '../lib/pageTitle'
import { LOADER_HEAD_SCRIPT } from '../lib/siteLoader'
import { pageUrl, personNode, websiteNode, type Node } from '../lib/structuredData'

interface Props {
  title: string
  /** A shorter title for search results when `title` is a long display headline. */
  seoTitle?: string
  description: string
  type?: 'website' | 'article'
  noindex?: boolean
  /** Let the page's single top-level element stretch to fill `main`, for short pages that must reach the footer. */
  fill?: boolean
  /** This page's own schema.org nodes, added to the person and the site. */
  schema?: Node[]
}

const { title, seoTitle, description, type = 'website', noindex = false, fill = false, schema = [] } = Astro.props
const cloudflare = beacon(analytics, { context: process.env.CONTEXT })
const fullTitle = pageTitle(title, seoTitle)
const canonical = pageUrl(Astro.url.pathname)
const siteNodes = [personNode(person, disciplines.map((discipline) => discipline.title), new URL(portrait.src, Astro.site).href), websiteNode()]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js')
      setTimeout(() => document.documentElement.classList.add('reveals-ready'), 3000)
    </script>
    <script is:inline set:html={LOADER_HEAD_SCRIPT} />
    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-archivo" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={BLOG_FEED_TITLE} href="/rss.xml" />
    <meta name="theme-color" content="#f86343" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <ShareMeta />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <JsonLd nodes={[...siteNodes, ...schema]} />
    <slot name="head" />
  </head>
  <body id="top" class="flex min-h-screen min-h-svh flex-col">
    <SiteLoader />
    <a
      href="#main"
      class="type-label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:bg-ink focus:px-4 focus:py-3 focus:text-ivory"
      >Skip to content</a
    >
    <SiteHeader />
    <main id="main" tabindex="-1" class:list={['flex-1 outline-none', fill && 'flex flex-col']}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initSiteLoader } from '../lib/siteLoader'
      import { initReveals } from '../lib/reveal'
      import { initVideosInView } from '../lib/videoInView'
      import { initHeaderScroll } from '../lib/headerScroll'
      import { initTocSpy } from '../lib/tocSpy'
      import { initBeforeAfter } from '../lib/beforeAfter'
      import { initStepArt } from '../lib/stepArt'
      initSiteLoader()
      initReveals()
      initVideosInView()
      initHeaderScroll()
      initTocSpy()
      initBeforeAfter()
      initStepArt()
    </script>
    {cloudflare && <script is:inline defer src={cloudflare.src} data-cf-beacon={cloudflare['data-cf-beacon']} />}
  </body>
</html>
