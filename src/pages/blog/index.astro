---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogHeader from '../../components/blog/BlogHeader.astro'
import LatestArticle from '../../components/blog/LatestArticle.astro'
import ArticleRow from '../../components/blog/ArticleRow.astro'
import TopicIndex from '../../components/blog/TopicIndex.astro'
import ContactBand from '../../components/sections/ContactBand.astro'
import { extraBlogSections } from '../../content/blogSections'
import { disciplines } from '../../content/disciplines'
import { blogSections } from '../../lib/blogSections'
import { blogNode } from '../../lib/structuredData'
import { BLOG_DESCRIPTION, articleCard, countLabel, countOutsideServices, indexIntro, latestArticles, requireTopic, topicGroups, topicSlug } from '../../lib/blog'

const topics = await getCollection('blogTopics')
const articles = await getCollection('blogArticles')
const [latest, ...more] = latestArticles(articles, 3).map((article) => articleCard(article, requireTopic(topics, topicSlug(article.id)).data.title))
const sections = blogSections(disciplines, extraBlogSections)
const intro = indexIntro(topics.length, disciplines.length, countOutsideServices(sections, topics))
---

<BaseLayout title="Blog" description={BLOG_DESCRIPTION} schema={[blogNode(BLOG_DESCRIPTION)]}>
  <BlogHeader topics={countLabel(topics.length, 'topic', 'topics')} articles={countLabel(articles.length, 'article', 'articles')} />
  {latest && <LatestArticle card={latest} />}
  {
    more.length > 0 && (
      <div class="mx-auto max-w-[1600px] px-6 md:px-12">
        <ul role="list">
          {more.map((card) => (
            <ArticleRow card={card} />
          ))}
        </ul>
      </div>
    )
  }
  <TopicIndex groups={topicGroups(sections, topics, articles)} intro={intro} />
  <ContactBand />
</BaseLayout>
