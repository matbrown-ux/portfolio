---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactIntro from '../../components/contact/ContactIntro.astro'
import ContactForm from '../../components/contact/ContactForm.astro'
import { webPageNode } from '../../lib/structuredData'
---

<BaseLayout
  fill
  title="Hire a UX/UI Engineer & SEO Specialist"
  description="Tell me about your UX/UI, SEO, AI workflow, brand or SaaS project. Send the form or email mat@matbrown.io."
  schema={[webPageNode('ContactPage', '/contact', 'Hire a UX/UI Engineer & SEO Specialist')]}
>
  {/* Clipped sideways because the form panel's color runs past the column to the screen edge.
      On a screen taller than the content the wrapper and the grid fill the page, so the panel
      stretches down to meet the footer. */}
  <div class="flex flex-1 flex-col overflow-x-clip bg-ivory">
    <div class="mx-auto grid w-full max-w-[1600px] flex-1 grid-rows-[auto_1fr] lg:grid-cols-[1fr_1.02fr] lg:grid-rows-1">
      <ContactIntro />
      <ContactForm class="lg:mt-[clamp(6.5rem,8vw,8rem)]" />
    </div>
  </div>
</BaseLayout>

<script>
  import { initContactForm } from '../../lib/contactForm'
  initContactForm()
</script>
