---
import { PAGE_ENTRANCE } from '../../lib/heroEntrance'
import ScriptArt from '../brand/ScriptArt.astro'
import VerticalLabel from '../ui/VerticalLabel.astro'

interface Props {
  /** How many disciplines the page lists. */
  count: number
}

const { count } = Astro.props
---

<section class="relative isolate overflow-hidden bg-ivory pb-10 pt-36 md:pt-44 lg:pb-14 lg:pt-[max(11rem,13vw)]">
  <div class="relative mx-auto grid max-w-[1600px] items-end gap-8 px-6 md:px-12 lg:grid-cols-[1fr_auto]">
    {/* Decorative: the h1 beside it carries the keywords. */}
    <p class="type-display relative inline-block justify-self-start text-[clamp(3rem,17.5vw,17.5rem)] leading-[0.82]" aria-hidden="true" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.display}>
      Services<span class="text-vermilion">.</span>
      <ScriptArt name="what-i-do" class="absolute -top-[0.23em] left-[58%] w-[46%] -rotate-[7deg] lg:left-[78%] lg:w-[51%]" reveal="wipe" on="load" delay={PAGE_ENTRANCE.art} />
    </p>
    <h1 class="type-label max-w-xs pb-4 lg:max-[1439px]:mr-16 before:mb-3 before:block before:h-0.5 before:w-10 before:bg-ink" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.title}>
      UX/UI Engineering, SEO &amp; AI Workflow Services
    </h1>
    <VerticalLabel class="absolute -top-8 right-6 border-r-2 border-ink pr-2 md:right-12 lg:top-0 lg:text-sm" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.label}>
      {count} disciplines<br />one person
    </VerticalLabel>
  </div>
</section>
