---
import Logo from '../brand/Logo.astro'
import Button from '../ui/Button.astro'
import MobileMenu from './MobileMenu.tsx'
import { contactLink, isCurrent, primaryNav } from '../../content/navigation'
import { profileLinks } from './profileIcons'

const { pathname } = Astro.url
const profiles = profileLinks()
---

{/* headerScroll.ts finds the header by data-site-header and sets data-header-state on it; the
    styles for those states are in global.css. With no state it is absolute, as written here. */}
<header data-site-header class="absolute inset-x-0 top-0 z-40">
  <div class="mx-auto flex max-w-[1600px] items-center gap-10 px-6 py-5 md:px-12">
    <a href="/" aria-label="Mathew Brown, home" class="block w-16 text-ink md:w-[4.5rem]"><Logo /></a>
    <nav aria-label="Primary" class="hidden md:block lg:ml-8">
      <ul role="list" class="flex gap-6 lg:gap-14">
        {
          primaryNav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href, pathname) ? 'page' : undefined}
                class="type-label underline-offset-8 decoration-vermilion decoration-2 hover:underline aria-[current=page]:underline"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto hidden items-center gap-2 md:flex lg:gap-4">
      <ul role="list" aria-label="Profiles" class="flex">
        {
          profiles.map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                aria-label={`${label}, opens in a new tab`}
                target="_blank"
                rel="me noopener"
                class="grid size-11 place-items-center text-ink transition-colors duration-200 hover:bg-ink hover:text-ivory focus-visible:bg-ink focus-visible:text-ivory focus-visible:outline-ink"
              >
                <span aria-hidden="true" class="block size-5 [&>svg]:block [&>svg]:size-full" set:html={icon} />
              </a>
            </li>
          ))
        }
      </ul>
      <Button href={contactLink.href} current={isCurrent(contactLink.href, pathname)}>{contactLink.label}</Button>
    </div>
    <div class="ml-auto md:hidden">
      <MobileMenu client:media="not all and (min-width: 48rem)" links={primaryNav} contact={contactLink} pathname={pathname} profiles={profiles} />
    </div>
  </div>
</header>
