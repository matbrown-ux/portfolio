---
import Logo from '../brand/Logo.astro'
import { footerNav } from '../../content/navigation'
import { profileLinks } from './profileIcons'

const profiles = profileLinks()
---

<footer class="bg-ink text-ivory">
  <div class="mx-auto flex max-w-[1600px] flex-col gap-8 px-6 py-8 md:flex-row md:items-center md:gap-8 md:px-12 lg:gap-12">
    <a href="/" aria-label="Mathew Brown, home" class="block w-16"><Logo /></a>
    <nav aria-label="Footer">
      <ul role="list" class="flex flex-wrap gap-x-10 gap-y-3 md:gap-x-6 lg:gap-x-10">
        {
          footerNav.map(({ label, href }) => (
            <li>
              <a href={href} class="type-label underline-offset-8 decoration-vermilion decoration-2 hover:underline">
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex shrink-0 items-center gap-4 md:ml-auto lg:gap-6">
      <ul role="list" aria-label="Profiles" class="-ml-3 flex md:ml-0">
        {
          profiles.map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                aria-label={`${label}, opens in a new tab`}
                target="_blank"
                rel="me noopener"
                class="grid size-11 place-items-center text-ivory transition-colors duration-200 hover:text-vermilion focus-visible:text-vermilion focus-visible:outline-ivory"
              >
                <span aria-hidden="true" class="block size-5 [&>svg]:block [&>svg]:size-full" set:html={icon} />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#top" class="type-label whitespace-nowrap opacity-70 hover:opacity-100 focus-visible:opacity-100">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
