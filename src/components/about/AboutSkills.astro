---
import { disciplines } from '../../content/disciplines'
---

<section class="bg-ivory" aria-labelledby="about-skills-heading">
  <div class="mx-auto max-w-[1600px] px-6 pb-14 pt-16 md:px-12 lg:pb-16 lg:pt-[min(5.5vw,5.5rem)]">
    <h2 id="about-skills-heading" class="type-display text-[clamp(2.75rem,5.6vw,5.75rem)] lg:max-w-[min(60vw,60rem)] leading-[0.95]" data-reveal="rise">Skills across five disciplines</h2>
    {/* One column on narrow phones, two from 400px, five from lg. Lines are drawn only between
        columns and between rows, and the first column keeps the heading's left edge. */}
    <ul role="list" class="mt-10 grid border-t-2 border-ink min-[400px]:grid-cols-2 lg:mt-12 lg:grid-cols-5">
      {
        disciplines.map((d, i) => (
          <li
            class="flex flex-col border-ink/15 pb-6 pt-5 max-[399px]:not-first:border-t min-[400px]:max-lg:nth-[n+3]:border-t min-[400px]:max-lg:odd:pr-4 min-[400px]:max-lg:even:border-l min-[400px]:max-lg:even:pl-4 lg:border-l lg:px-[min(1.4vw,1.4rem)] lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0"
            data-reveal="rise"
            data-reveal-index={i}
          >
            <span class="type-label" aria-hidden="true">
              {d.number}
            </span>
            <h3 class="type-display mt-2 text-[clamp(1.375rem,1.9vw,2rem)]">{d.title}</h3>
            <ul role="list" class="mb-4 mt-4">
              {d.skills.map((skill) => <li class="type-label border-t border-ink/15 py-1.5 font-medium">{skill}</li>)}
            </ul>
            <a
              href={`/services#${d.slug}`}
              class="type-label mt-auto self-start underline-offset-8 decoration-vermilion decoration-2 hover:underline focus-visible:underline"
              aria-label={`See the ${d.title} service`}
            >
              See the service <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
