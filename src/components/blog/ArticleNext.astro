---
import type { Tile } from '../../lib/blog'

interface Props {
  tiles: [Tile, Tile, Tile]
}

const { tiles } = Astro.props
---

<section class="bg-stone" aria-labelledby="next-heading">
  <h2 id="next-heading" class="sr-only">Where to go next</h2>
  <ul role="list" class="mx-auto grid max-w-[1600px] lg:grid-cols-3">
    {
      tiles.map((tile, i) => (
        <li class:list={['border-t border-ink/15 first:border-t-0 lg:border-l lg:border-t-0 lg:first:border-l-0', i === 1 && 'bg-vermilion']}>
          <a href={tile.href} class="group flex h-full flex-col px-6 py-8 focus-visible:outline-ink focus-visible:-outline-offset-4 md:px-12 lg:px-8 lg:py-10 lg:first:pl-12">
            <span class="type-label">{tile.label}</span>
            <span class="type-display mt-3 text-[clamp(1.75rem,2.4vw,2.5rem)]">{tile.title}</span>
            <span class="mt-3 max-w-sm leading-snug">{tile.text}</span>
            <span class="type-label mt-auto pt-8">
              {tile.cta}{' '}
              <span aria-hidden="true" class="inline-block transition-transform duration-200 motion-safe:group-hover:-translate-y-0.5 motion-safe:group-hover:translate-x-0.5 motion-reduce:transition-none">↗</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
