---
import { PAGE_ENTRANCE } from '../../lib/heroEntrance'
import ScriptArt from '../brand/ScriptArt.astro'
import VerticalLabel from '../ui/VerticalLabel.astro'

interface Props {
  count: string
  years: string
}

const { count, years } = Astro.props
---

<section class="relative isolate overflow-hidden bg-ivory pb-12 pt-36 md:pt-44 lg:pb-16 lg:pt-[max(11rem,13vw)]">
  <div class="relative mx-auto grid max-w-[1600px] items-end gap-8 px-6 md:px-12 lg:grid-cols-[1fr_auto]">
    {/* Decorative: the h1 beside it carries the keywords. */}
    <p class="type-display relative inline-block justify-self-start text-[clamp(7rem,22vw,22rem)] leading-[0.82]" aria-hidden="true" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.display}>
      Work<span class="text-vermilion">.</span>
      <ScriptArt name="selected" class="absolute -top-[0.21em] left-[50%] w-[46%] -rotate-[7deg] md:left-[66%] md:w-[50%]" reveal="wipe" on="load" delay={PAGE_ENTRANCE.art} />
    </p>
    <h1 class="type-label max-w-xs pb-4 before:mb-3 before:block before:h-0.5 before:w-10 before:bg-ink" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.title}>
      UX/UI Engineering &amp; SEO Case Studies
    </h1>
    <VerticalLabel class="absolute -top-8 right-6 border-r-2 border-ink pr-2 md:right-12 lg:top-0 lg:text-sm" data-reveal="rise" data-reveal-on="load" data-reveal-delay={PAGE_ENTRANCE.label}>
      {count}<br />{years}
    </VerticalLabel>
  </div>
</section>
