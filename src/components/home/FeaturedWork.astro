---
import { getCollection } from 'astro:content'
import MediaSlot from '../media/MediaSlot.astro'
import { tileMedia } from '../../lib/caseStudyMedia'
import { featuredWork } from '../../lib/featuredWork'

const entries = await getCollection('caseStudies')
const tiles = featuredWork(entries)
// Media per tile id; null leaves the tile a plain colour block.
const media = Object.fromEntries(entries.map((entry) => [entry.id, tileMedia(entry.data.media?.tile, `${entry.id} tile`)]))

// Each tile swaps fill on hover and focus. Small vermilion text is only allowed on ink, so only the
// dark tile has a vermilion number, and it turns ink when the tile turns vermilion.
const cell = {
  tall: 'md:row-span-2',
  accent: '',
  dark: '',
}
// With media the tile is covered by positioned layers that would hide its inset outline, so the ring
// is a border on a pseudo-element above them (as on the Work rows). Without media the outline is used.
const ring = 'after:pointer-events-none after:absolute after:inset-1 after:z-10 focus-visible:outline-hidden focus-visible:after:border-2 focus-visible:after:border-current'
const surface = {
  tall: 'bg-stone text-ink hover:bg-ink hover:text-ivory focus-visible:bg-ink focus-visible:text-ivory',
  accent: 'bg-vermilion text-ink hover:bg-ink hover:text-ivory focus-visible:bg-ink focus-visible:text-ivory',
  dark: 'bg-ink text-ivory hover:bg-vermilion hover:text-ink focus-visible:bg-vermilion focus-visible:text-ink',
}
---

<section class="overflow-x-clip bg-ivory" aria-labelledby="featured-work-heading">
  <div class="mx-auto max-w-[1600px] px-6 pb-12 pt-20 md:px-12 lg:pb-16 lg:pt-24 lg:pr-0">
    <h2 id="featured-work-heading" class="type-display text-[clamp(3rem,7.4vw,7.5rem)]" data-reveal="rise">Featured work</h2>
    <div class="mt-8 flex flex-col gap-4 lg:mt-12 lg:flex-row">
      <ul role="list" class="grid flex-1 gap-4 md:auto-rows-[minmax(15rem,17vw)] md:grid-cols-[1.15fr_1fr]">
        {
          tiles.map((tile, i) => {
            const tileImage = media[tile.id]
            return (
            <li class:list={[cell[tile.variant]]} data-reveal="rise" data-reveal-index={i}>
              <a href={tile.href} class:list={['group relative isolate flex h-full overflow-hidden min-h-52 flex-col p-6 transition-colors duration-200 focus-visible:-outline-offset-4 motion-reduce:transition-none lg:p-7', surface[tile.variant], tileImage && ring]}>
                {tileImage && (
                  <>
                    <MediaSlot media={tileImage} class="absolute inset-0" sizes="(min-width: 768px) 50vw, 100vw" />
                    <span class="absolute inset-0 bg-inherit opacity-80 transition-opacity duration-200 group-hover:opacity-90 group-focus-visible:opacity-90 motion-reduce:transition-none" aria-hidden="true" />
                  </>
                )}
                <span
                  class:list={[
                    'type-label relative text-sm',
                    tile.variant === 'dark' && 'text-vermilion transition-colors duration-200 group-hover:text-ink group-focus-visible:text-ink motion-reduce:transition-none',
                  ]}
                >{tile.number} /</span>
                <h3 class="type-display relative mt-2 max-w-[10ch] text-[clamp(2rem,3.1vw,3.25rem)]">{tile.title}</h3>
                <p class="type-label relative mt-3 font-medium">{tile.tags.join(', ')}</p>
                <span
                  class="relative mt-auto inline-block pt-6 text-2xl transition-transform duration-200 motion-safe:group-hover:-translate-y-1 motion-safe:group-hover:translate-x-1 motion-reduce:transition-none"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </a>
            </li>
            )
          })
        }
      </ul>
      <a
        href="/work"
        class="type-label flex items-center justify-center gap-2 bg-vermilion px-5 py-4 text-ink transition-colors duration-200 hover:bg-ink hover:text-ivory focus-visible:outline-ink lg:relative lg:w-[5.5rem] lg:rotate-180 lg:justify-start lg:p-0 lg:pt-10 lg:[writing-mode:vertical-rl] lg:after:absolute lg:after:bottom-0 lg:after:right-full lg:after:top-0 lg:after:w-screen lg:after:bg-inherit"
      >
        View all projects <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
