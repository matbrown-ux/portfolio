---
import ScriptArt from '../brand/ScriptArt.astro'
import Button from '../ui/Button.astro'
import { contactLink } from '../../content/navigation'
---

<section class="overflow-hidden border-t border-line-dark bg-ink text-ivory">
  <div
    class="mx-auto grid max-w-[1600px] gap-10 px-6 pb-16 pt-24 md:px-12 md:pt-32 lg:pb-20 lg:pt-[clamp(9rem,11.1vw,11.5rem)] xl:grid-cols-[1fr_auto] xl:items-end"
  >
    {/* Read aloud as "I build memorable websites." The struck word and the artwork are decorative. */}
    <h2 class="type-display text-[clamp(2.5rem,13.3vw,3.25rem)] sm:text-[clamp(3.25rem,9.6vw,10rem)]" data-reveal="rise">
      I build{' '}
      <span class="relative inline-block">
        <span class="opacity-40" aria-hidden="true">average</span>
        <span class="sr-only">memorable</span>
        <ScriptArt name="strike" class="absolute left-[-6%] top-[28%] w-[110%]" reveal="wipe" delay={0.2} />
        <ScriptArt name="memorable" class="absolute bottom-[84%] left-[7%] w-[114%] -rotate-6 sm:left-[9%] sm:w-[120%]" reveal="wipe" delay={0.5} />
      </span>
      <br />
      websites.
    </h2>
    <div class="max-w-xs">
      <p class="type-label">I design them to be remembered and build them to rank.</p>
      <Button href={contactLink.href} on="dark" class="mt-5">{contactLink.label}</Button>
    </div>
  </div>
</section>
