---
import { Image } from 'astro:assets'
import portrait from '../../assets/portraits/about.png'
import Button from '../ui/Button.astro'
---

<section class="relative isolate overflow-hidden bg-ivory lg:h-[40vw] lg:max-h-[640px] lg:min-h-[480px] lg:[--gutter:max(0px,calc(50%-800px))]" aria-labelledby="about-heading">
  <p
    class="type-display px-6 pt-10 text-[clamp(4rem,11vw,11rem)] leading-[0.86] md:px-12 lg:absolute lg:bottom-[7%] lg:left-[calc(var(--gutter)+3rem)] lg:top-[7%] lg:rotate-180 lg:px-0 lg:pt-0 lg:[writing-mode:vertical-rl]"
    aria-hidden="true"
  >
    Mathew
  </p>

  <div class="relative h-[90vw] max-h-[560px] lg:static lg:h-auto lg:max-h-none">
    <Image
      src={portrait}
      alt="Mathew Brown in profile"
      widths={[480, 720, 1000]}
      sizes="(min-width: 1024px) 30vw, 70vw"
      class="absolute bottom-0 left-[14%] h-[96%] w-auto lg:left-[calc(var(--gutter)+min(27%,432px))]"
    />
    <div class="absolute inset-x-0 bottom-0 top-[47%] bg-vermilion mix-blend-multiply lg:right-auto lg:w-[calc(var(--gutter)+min(58%,928px))]" data-reveal="wipe"></div>
  </div>

  <div class="relative z-10 max-w-xl px-6 py-12 md:px-12 lg:absolute lg:left-[calc(var(--gutter)+min(60%,960px))] lg:right-[calc(var(--gutter)+3rem)] lg:top-[26%] lg:max-w-none lg:p-0">
    <h2 id="about-heading" class="type-display text-[clamp(2.5rem,4.2vw,4.25rem)]">
      Freelance UX/UI Engineer &amp; SEO Specialist
    </h2>
    <p class="mt-5 max-w-md text-base leading-relaxed">
      I'm a freelance UX/UI engineer, SEO/AEO specialist and agentic workflow developer.
    </p>
    <Button href="/about" variant="outline" class="mt-7">More about me</Button>
  </div>
</section>
