---
import { auditSteps } from '../../content/audit'
---

<section class="bg-ink text-ivory" aria-labelledby="steps-heading">
  <div class="mx-auto max-w-[1600px] px-6 py-16 md:px-12 lg:py-24">
    <p class="type-label text-vermilion"><span aria-hidden="true">// </span>The process</p>
    <h2 id="steps-heading" class="type-display mt-4 text-[clamp(2.25rem,4.2vw,4.25rem)] leading-[0.95]" data-reveal="rise">How the audit works</h2>
    <ol role="list" class="mt-10 grid gap-px bg-line-dark md:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {
        auditSteps.map((step, i) => (
          <li class="bg-ink py-8 pr-6 md:px-6 lg:min-h-[19rem] lg:px-7 lg:py-9 first:md:pl-0" data-reveal="fade" data-reveal-index={i} data-reveal-step="0.12">
            <p class="type-label text-vermilion">Step {String(i + 1).padStart(2, '0')}</p>
            <h3 class="type-display mt-4 text-[clamp(1.75rem,2.3vw,2.5rem)] leading-none">{step.title}</h3>
            <p class="mt-4 max-w-sm text-[clamp(1rem,1.12vw,1.125rem)] leading-relaxed text-ivory/80">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
