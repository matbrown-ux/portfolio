---
import { Image } from 'astro:assets'
import type { CaseStudyMedia } from '../../lib/caseStudyMedia'

interface Props {
  media: CaseStudyMedia
  /** Which placeholder stripe reads on the surface behind this slot. */
  tone?: 'light' | 'dark'
  /** Wrap the media in the ink-outlined browser bar. */
  frame?: 'browser'
  /** Shown in the browser bar. */
  url?: string
  /** Load an image straight away (the case study hero). */
  eager?: boolean
  sizes?: string
  /** Classes for the media area alone, under the browser bar: its shape, for example. */
  areaClass?: string
  /** How a video starts: by itself while on screen, muted and looping, or when the visitor presses play, with sound. */
  start?: 'in-view' | 'click'
  /** The second line of a placeholder, for a reader of the published page. */
  note?: string
  class?: string
  /** Any other attribute, such as a data-reveal, goes on the slot's outer element. */
  [attribute: `data-${string}`]: string | number | undefined
}

const { media, tone = 'light', frame, url, eager = false, note = 'Screenshot, recording or photo to come', start = 'in-view', sizes = '(min-width: 1024px) 50vw, 100vw', areaClass, class: className, ...rest } = Astro.props
---

<div class:list={['flex flex-col', frame === 'browser' && 'border-2 border-ink bg-ivory', className]} {...rest}>
  {
    frame === 'browser' && (
      <div class="type-label flex items-center gap-1.5 border-b-2 border-ink px-3 py-2 font-medium normal-case tracking-normal" aria-hidden="true">
        <span class="size-2 bg-ink" />
        <span class="size-2 bg-ink" />
        <span class="size-2 bg-ink" />
        {url && <span class="ml-3">{url}</span>}
      </div>
    )
  }
  <div class:list={['relative min-h-0 flex-1', areaClass]}>
    {
      media.kind === 'placeholder' && (
        <div
          class:list={[
            'type-label grid h-full min-h-40 place-items-center p-6 text-center',
            tone === 'dark' ? 'media-placeholder-dark' : 'media-placeholder',
          ]}
          role="img"
          aria-label={`${media.alt}. ${note}`}
        >
          <p>
            {media.alt}
            <span class="mt-1 block font-medium">{note}</span>
          </p>
        </div>
      )
    }
    {
      media.kind === 'image' && (
        <Image
          src={media.image}
          alt={media.alt}
          widths={[640, 960, 1280, 1920]}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          class="h-full w-full object-cover"
        />
      )
    }
    {
      media.kind === 'video' && start === 'in-view' && (
        <video
          data-play-in-view
          muted
          playsinline
          loop
          preload="none"
          poster={media.poster.src}
          aria-label={media.alt}
          class="h-full w-full object-cover"
        >
          <source src={media.url} type={media.type} />
        </video>
      )
    }
    {
      /* Without JavaScript the native controls start it; with it, src/lib/videoPlayButton.ts puts a play button over the poster. */
      media.kind === 'video' && start === 'click' && (
        <video
          data-play-on-click
          controls
          playsinline
          preload="metadata"
          poster={media.poster.src}
          aria-label={media.alt}
          class="h-full w-full object-cover"
        >
          <source src={media.url} type={media.type} />
        </video>
      )
    }
  </div>
</div>
