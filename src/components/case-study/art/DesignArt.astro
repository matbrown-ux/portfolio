---
/**
 * Step art: a folder of clips becomes a designed site with a logo, a palette and copy.
 * The markup is the finished drawing. Parts marked `data-art` are animated by src/lib/stepArt.ts
 * (`data-art-at` is seconds into the loop). Colors come from the palette tokens only.
 */
interface Props {
  label: string
}

const { label } = Astro.props
---

<svg viewBox="0 0 800 470" role="img" aria-label={label} class="block h-full w-full" preserveAspectRatio="xMidYMid slice" data-step-art>
  <defs>
    <pattern id="art-design-dots" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(24)">
      <circle cx="4" cy="4" r="2.6" fill="var(--color-vermilion)" />
    </pattern>
  </defs>
  <rect width="800" height="470" fill="var(--color-ivory)" />
  <circle cx="170" cy="330" r="170" fill="url(#art-design-dots)" data-art="fade" data-art-at="0" />
  {/* The folder of clips the creator has now */}
  <text x="70" y="96" class="font-display" font-size="26" fill="var(--color-ink)">60 CLIPS</text>
  <g transform="rotate(-10 145 170)"><rect x="70" y="120" width="150" height="100" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" /><polygon points="133,154 161,170 133,186" fill="var(--color-ink)" /></g>
  <g transform="rotate(7 187 226)"><rect x="112" y="176" width="150" height="100" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" /><polygon points="175,210 203,226 175,242" fill="var(--color-ink)" /></g>
  <g transform="rotate(-4 153 288)"><rect x="78" y="238" width="150" height="100" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" /><polygon points="141,272 169,288 141,304" fill="var(--color-ink)" /></g>
  <g stroke="var(--color-ink)" stroke-linecap="square">
    <line x1="272" y1="215" x2="318" y2="215" stroke="var(--color-ink)" stroke-width="5" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="0.6" />
    <line x1="284" y1="237" x2="318" y2="237" stroke="var(--color-ink)" stroke-width="5" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="0.7" />
    <line x1="272" y1="259" x2="318" y2="259" stroke="var(--color-ink)" stroke-width="5" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="0.8" />
  </g>
  <polygon points="318,199 348,237 318,275" fill="var(--color-ink)" data-art="pop" data-art-at="0.9" />
  {/* The site designed around their work */}
  <rect x="384" y="64" width="380" height="350" fill="var(--color-ink)" />
  <rect x="370" y="50" width="380" height="350" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
  <line x1="370" y1="96" x2="750" y2="96" stroke="var(--color-ink)" stroke-width="4" />
  <line x1="600" y1="73" x2="636" y2="73" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  <line x1="650" y1="73" x2="686" y2="73" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  <polygon points="402.0,56.0 405.4,64.7 414.0,61.0 410.3,69.6 419.0,73.0 410.3,76.4 414.0,85.0 405.4,81.3 402.0,90.0 398.6,81.3 390.0,85.0 393.7,76.4 385.0,73.0 393.7,69.6 390.0,61.0 398.6,64.7" fill="var(--color-ink)" data-art="pop" data-art-at="1.4" />
  <line x1="394" y1="140" x2="584" y2="140" stroke="var(--color-ink)" stroke-width="16" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.9" />
  <line x1="394" y1="166" x2="534" y2="166" stroke="var(--color-ink)" stroke-width="16" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.1" />
  <rect x="610" y="120" width="116" height="150" fill="none" stroke="var(--color-ink)" stroke-width="3" />
  <line x1="610" y1="120" x2="726" y2="270" stroke="var(--color-ink)" stroke-width="3" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.3" />
  <line x1="726" y1="120" x2="610" y2="270" stroke="var(--color-ink)" stroke-width="3" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.4" />
  <line x1="394" y1="200" x2="584" y2="200" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.6" opacity="0.6" />
  <line x1="394" y1="216" x2="570" y2="216" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.7" opacity="0.6" />
  <line x1="394" y1="232" x2="520" y2="232" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.8" opacity="0.6" />
  <rect x="394" y="252" width="92" height="30" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="3.1" />
  {/* The palette */}
  <rect x="394" y="322" width="44" height="44" fill="var(--color-ink)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="3.5" />
  <rect x="446" y="322" width="44" height="44" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="3.65" />
  <rect x="498" y="322" width="44" height="44" fill="var(--color-stone)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="3.8" />
  <g data-art="pop" data-art-at="4.4">
    <polygon points="721.7,18.7 729.1,43.1 750.9,29.8 746.9,55.0 772.3,52.4 757.7,73.4 781.7,82.1 759.5,94.7 777.4,112.9 751.9,114.6 760.1,138.8 736.4,129.3 733.3,154.7 716.1,135.8 702.3,157.3 694.9,132.9 673.1,146.2 677.1,121.0 651.7,123.6 666.3,102.6 642.3,93.9 664.5,81.3 646.6,63.1 672.1,61.4 663.9,37.2 687.6,46.7 690.7,21.3 707.9,40.2" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="4" />
    <text x="712" y="96" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ink)" transform="rotate(8 712 88)">ON BRAND!</text>
  </g>
</svg>
