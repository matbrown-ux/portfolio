---
/**
 * Step art: the creator asks for changes in three rounds and each one lands on the site.
 * The markup is the finished drawing. Parts marked `data-art` are animated by src/lib/stepArt.ts
 * (`data-art-at` is seconds into the loop). Colours come from the palette tokens only.
 */
interface Props {
  label: string
}

const { label } = Astro.props
---

<svg viewBox="0 0 800 470" role="img" aria-label={label} class="block h-full w-full" preserveAspectRatio="xMidYMid slice" data-step-art>
  <defs>
    <pattern id="art-revisions-dots" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(24)">
      <circle cx="4" cy="4" r="2.6" fill="var(--color-vermilion)" />
    </pattern>
  </defs>
  <rect width="800" height="470" fill="var(--color-ivory)" />
  <circle cx="150" cy="130" r="160" fill="url(#art-revisions-dots)" data-art="fade" data-art-at="0" />
  {/* The first version, on a private link */}
  <rect x="74" y="84" width="360" height="310" fill="var(--color-ink)" />
  <rect x="60" y="70" width="360" height="310" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
  <line x1="60" y1="106" x2="420" y2="106" stroke="var(--color-ink)" stroke-width="4" />
  <rect x="76" y="84" width="9" height="9" fill="var(--color-ink)" /><rect x="92" y="84" width="9" height="9" fill="var(--color-ink)" /><rect x="108" y="84" width="9" height="9" fill="var(--color-ink)" />
  <line x1="84" y1="142" x2="290" y2="142" stroke="var(--color-ink)" stroke-width="14" />
  <rect x="84" y="170" width="150" height="96" fill="none" stroke="var(--color-ink)" stroke-width="3" />
  <rect x="250" y="170" width="146" height="42" fill="none" stroke="var(--color-ink)" stroke-width="3" />
  <rect x="250" y="224" width="146" height="42" fill="none" stroke="var(--color-ink)" stroke-width="3" />
  <line x1="84" y1="296" x2="396" y2="296" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  <line x1="84" y1="314" x2="340" y2="314" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  {/* What each round changes */}
  <rect x="84" y="170" width="150" height="96" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="1.2" />
  <rect x="250" y="170" width="146" height="42" fill="var(--color-ink)" data-art="pop" data-art-at="2.6" />
  <line x1="84" y1="346" x2="300" y2="346" stroke="var(--color-vermilion)" stroke-width="12" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="4.0" />
  <g data-art="pop" data-art-at="0.5">
    <path d="M500 58 h236 v80 h-196 l-28 24 l4 -24 h-16 z" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="miter" />
    <circle cx="532" cy="98" r="21" fill="var(--color-ink)" />
    <text x="532" y="108" text-anchor="middle" class="font-display" font-size="28" fill="var(--color-ivory)">1</text>
    <line x1="566" y1="88" x2="676" y2="88" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
    <line x1="566" y1="108" x2="646" y2="108" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
  </g>
  <path d="M690 96 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.4" />
  <g data-art="pop" data-art-at="1.9">
    <path d="M500 170 h236 v80 h-196 l-28 24 l4 -24 h-16 z" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="miter" />
    <circle cx="532" cy="210" r="21" fill="var(--color-ink)" />
    <text x="532" y="220" text-anchor="middle" class="font-display" font-size="28" fill="var(--color-ivory)">2</text>
    <line x1="566" y1="200" x2="676" y2="200" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
    <line x1="566" y1="220" x2="646" y2="220" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
  </g>
  <path d="M690 208 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.8" />
  <g data-art="pop" data-art-at="3.3">
    <path d="M500 282 h236 v80 h-196 l-28 24 l4 -24 h-16 z" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="miter" />
    <circle cx="532" cy="322" r="21" fill="var(--color-ink)" />
    <text x="532" y="332" text-anchor="middle" class="font-display" font-size="28" fill="var(--color-ivory)">3</text>
    <line x1="566" y1="312" x2="676" y2="312" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
    <line x1="566" y1="332" x2="646" y2="332" stroke="var(--color-ink)" stroke-width="4" opacity="0.5" />
  </g>
  <path d="M690 320 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="4.2" />
  <g data-art="pop" data-art-at="5.0">
    <polygon points="361.7,-7.3 376.2,16.2 394.5,-4.5 397.4,23.0 422.9,12.3 413.6,38.2 441.2,39.7 421.5,59.0 445.7,72.3 419.6,81.2 435.7,103.6 408.3,100.4 413.1,127.6 389.8,112.7 382.3,139.3 367.8,115.8 349.5,136.5 346.6,109.0 321.1,119.7 330.4,93.8 302.8,92.3 322.5,73.0 298.3,59.7 324.4,50.8 308.3,28.4 335.7,31.6 330.9,4.4 354.2,19.3" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="4" />
    <text x="372" y="74" text-anchor="middle" class="font-display" font-size="21" fill="var(--color-ink)" transform="rotate(-8 372 66)">APPROVED!</text>
  </g>
</svg>
