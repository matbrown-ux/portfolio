---
/**
 * Step art: the writer searches the keyword, reads the pages that rank and checks each fact at its source.
 * The markup is the finished drawing. Parts marked `data-art` are animated by src/lib/stepArt.ts
 * (`data-art-at` is seconds into the loop). Colors come from the palette tokens only.
 */
interface Props {
  label: string
}

const { label } = Astro.props
---

<svg viewBox="0 0 800 470" role="img" aria-label={label} class="block h-full w-full" preserveAspectRatio="xMidYMid slice" data-step-art>
  <defs>
    <pattern id="art-research-dots" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(24)">
      <circle cx="4" cy="4" r="2.6" fill="var(--color-vermilion)" />
    </pattern>
  </defs>
  <rect width="800" height="470" fill="var(--color-ivory)" />
  <circle cx="690" cy="150" r="170" fill="url(#art-research-dots)" data-art="fade" data-art-at="0" />

  {/* The search bar, with the keyword typed in */}
  <rect x="74" y="54" width="420" height="56" fill="var(--color-ink)" />
  <rect x="60" y="40" width="420" height="56" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
  <circle cx="90" cy="66" r="11" fill="none" stroke="var(--color-ink)" stroke-width="4" />
  <line x1="98" y1="74" x2="108" y2="84" stroke="var(--color-ink)" stroke-width="5" stroke-linecap="square" />
  <line x1="128" y1="68" x2="360" y2="68" stroke="var(--color-ink)" stroke-width="6" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="0.4" />

  {/* The pages that rank, each one read */}
  <g data-art="slide" data-art-at="1.0">
    <rect x="60" y="128" width="420" height="56" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="3" />
    <circle cx="90" cy="156" r="16" fill="var(--color-ink)" />
    <text x="90" y="164" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ivory)">1</text>
    <line x1="120" y1="148" x2="330" y2="148" stroke="var(--color-ink)" stroke-width="5" />
    <line x1="120" y1="166" x2="290" y2="166" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  </g>
  <g data-art="slide" data-art-at="1.3">
    <rect x="60" y="198" width="420" height="56" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="3" />
    <circle cx="90" cy="226" r="16" fill="var(--color-ink)" />
    <text x="90" y="234" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ivory)">2</text>
    <line x1="120" y1="218" x2="350" y2="218" stroke="var(--color-ink)" stroke-width="5" />
    <line x1="120" y1="236" x2="270" y2="236" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  </g>
  <g data-art="slide" data-art-at="1.6">
    <rect x="60" y="268" width="420" height="56" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="3" />
    <circle cx="90" cy="296" r="16" fill="var(--color-ink)" />
    <text x="90" y="304" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ivory)">3</text>
    <line x1="120" y1="288" x2="310" y2="288" stroke="var(--color-ink)" stroke-width="5" />
    <line x1="120" y1="306" x2="300" y2="306" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  </g>
  <path d="M424 156 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.0" />
  <path d="M424 226 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.2" />
  <path d="M424 296 l9 12 l18 -26" fill="none" stroke="var(--color-vermilion)" stroke-width="7" stroke-linecap="square" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.4" />

  {/* Speed lines to the source */}
  <g stroke="var(--color-ink)" stroke-width="5" stroke-linecap="square">
    <line x1="500" y1="130" x2="556" y2="130" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.8" />
    <line x1="512" y1="152" x2="556" y2="152" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.9" />
    <line x1="500" y1="174" x2="556" y2="174" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="3.0" />
  </g>

  {/* The primary source, with the fact underlined */}
  <g data-art="slide" data-art-at="3.1">
    <rect x="594" y="54" width="170" height="200" fill="var(--color-ink)" />
    <rect x="580" y="40" width="170" height="200" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
    <rect x="580" y="40" width="170" height="40" fill="var(--color-ink)" />
    <text x="665" y="70" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ivory)">SOURCE</text>
    <line x1="598" y1="104" x2="728" y2="104" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
    <line x1="598" y1="124" x2="708" y2="124" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
    <line x1="598" y1="150" x2="718" y2="150" stroke="var(--color-ink)" stroke-width="6" />
    <line x1="598" y1="176" x2="728" y2="176" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
    <line x1="598" y1="196" x2="690" y2="196" stroke="var(--color-ink)" stroke-width="4" opacity="0.45" />
  </g>
  <line x1="596" y1="162" x2="722" y2="162" stroke="var(--color-vermilion)" stroke-width="7" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="3.6" />

  <g transform="translate(20 24)">
  <g data-art="pop" data-art-at="4.1">
    <polygon points="669.2,238.5 679.8,271.2 708.0,251.5 703.3,285.6 737.3,280.1 718.3,308.8 751.3,318.6 721.7,336.2 747.2,359.3 712.9,362.3 725.8,394.3 693.6,382.1 691.4,416.5 667.7,391.5 650.8,421.5 640.2,388.8 612.0,408.5 616.7,374.4 582.7,379.9 601.7,351.2 568.7,341.4 598.3,323.8 572.8,300.7 607.1,297.7 594.2,265.7 626.4,277.9 628.6,243.5 652.3,268.5" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="4" />
    <text x="660" y="340" text-anchor="middle" class="font-display" font-size="24" fill="var(--color-ink)" transform="rotate(-6 660 332)">SOURCED!</text>
  </g>
  </g>
</svg>
