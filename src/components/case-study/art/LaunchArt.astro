---
/**
 * Step art: the finished site goes live on the creator's own domain, on desktop and phone.
 * The markup is the finished drawing. Parts marked `data-art` are animated by src/lib/stepArt.ts
 * (`data-art-at` is seconds into the loop). Colours come from the palette tokens only.
 */
interface Props {
  label: string
}

const { label } = Astro.props
---

<svg viewBox="0 0 800 470" role="img" aria-label={label} class="block h-full w-full" preserveAspectRatio="xMidYMid slice" data-step-art>
  <defs>
    <pattern id="art-launch-dots" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(24)">
      <circle cx="4" cy="4" r="2.6" fill="var(--color-vermilion)" />
    </pattern>
  </defs>
  <rect width="800" height="470" fill="var(--color-ivory)" />
  <circle cx="400" cy="235" r="215" fill="url(#art-launch-dots)" data-art="fade" data-art-at="0" />
  {/* The site on the creator's own domain */}
  <rect x="94" y="84" width="420" height="300" fill="var(--color-ink)" />
  <rect x="80" y="70" width="420" height="300" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
  <line x1="80" y1="114" x2="500" y2="114" stroke="var(--color-ink)" stroke-width="4" />
  <rect x="96" y="88" width="9" height="9" fill="var(--color-ink)" /><rect x="112" y="88" width="9" height="9" fill="var(--color-ink)" /><rect x="128" y="88" width="9" height="9" fill="var(--color-ink)" />
  <rect x="154" y="80" width="250" height="25" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="3" />
  <text x="166" y="98" font-family="var(--font-mono)" font-weight="700" font-size="13" letter-spacing="1.5" fill="var(--color-ink)" data-art="slide" data-art-at="0.6">YOURNAME.COM</text>
  <line x1="104" y1="154" x2="344" y2="154" stroke="var(--color-ink)" stroke-width="16" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.3" />
  <line x1="104" y1="180" x2="274" y2="180" stroke="var(--color-ink)" stroke-width="16" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.5" />
  <rect x="104" y="206" width="180" height="130" fill="none" stroke="var(--color-ink)" stroke-width="3" />
  <line x1="104" y1="206" x2="284" y2="336" stroke="var(--color-ink)" stroke-width="3" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.8" />
  <line x1="284" y1="206" x2="104" y2="336" stroke="var(--color-ink)" stroke-width="3" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="1.9" />
  <line x1="304" y1="216" x2="476" y2="216" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.1" opacity="0.6" />
  <line x1="304" y1="234" x2="460" y2="234" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.2" opacity="0.6" />
  <line x1="304" y1="252" x2="420" y2="252" stroke="var(--color-ink)" stroke-width="4" pathLength="1" stroke-dasharray="1" data-art="draw" data-art-at="2.3" opacity="0.6" />
  <rect x="304" y="278" width="96" height="30" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="3" data-art="pop" data-art-at="2.6" />
  {/* And on a phone */}
  <g data-art="slide" data-art-at="3.0">
    <rect x="584" y="164" width="124" height="226" fill="var(--color-ink)" />
    <rect x="572" y="152" width="124" height="226" fill="var(--color-ivory)" stroke="var(--color-ink)" stroke-width="4" />
    <line x1="616" y1="166" x2="652" y2="166" stroke="var(--color-ink)" stroke-width="5" />
    <line x1="588" y1="196" x2="680" y2="196" stroke="var(--color-ink)" stroke-width="11" />
    <rect x="588" y="214" width="92" height="72" fill="none" stroke="var(--color-ink)" stroke-width="3" />
    <line x1="588" y1="304" x2="680" y2="304" stroke="var(--color-ink)" stroke-width="4" opacity="0.6" />
    <line x1="588" y1="320" x2="656" y2="320" stroke="var(--color-ink)" stroke-width="4" opacity="0.6" />
    <rect x="588" y="338" width="60" height="22" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="3" />
  </g>
  {/* Found in search */}
  <g data-art="pop" data-art-at="3.6">
    <rect x="60" y="392" width="170" height="38" fill="var(--color-ink)" />
    <text x="145" y="419" text-anchor="middle" class="font-display" font-size="22" fill="var(--color-ivory)">SEO + AEO</text>
  </g>
  <g data-art="pop" data-art-at="4.3">
    <polygon points="552.6,-3.1 569.6,28.1 590.0,-0.9 593.8,34.4 623.8,15.3 613.7,49.4 648.7,43.3 626.4,70.9 661.1,78.6 629.9,95.6 658.9,116.0 623.6,119.8 642.7,149.8 608.6,139.7 614.7,174.7 587.1,152.4 579.4,187.1 562.4,155.9 542.0,184.9 538.2,149.6 508.2,168.7 518.3,134.6 483.3,140.7 505.6,113.1 470.9,105.4 502.1,88.4 473.1,68.0 508.4,64.2 489.3,34.2 523.4,44.3 517.3,9.3 544.9,31.6" fill="var(--color-vermilion)" stroke="var(--color-ink)" stroke-width="4" />
    <text x="566" y="109" text-anchor="middle" class="font-display" font-size="46" fill="var(--color-ink)" transform="rotate(-8 566 92)">LIVE!</text>
  </g>
</svg>
