---
import { HERO_ENTRANCE, stripReveal } from '../../lib/heroEntrance'
import type { CollectionEntry } from 'astro:content'
import VerticalLabel from '../ui/VerticalLabel.astro'

interface Props {
  entry: CollectionEntry<'caseStudies'>
}

const { title, client, role, year, stack, result } = Astro.props.entry.data
---

<section class="bg-ink text-ivory" aria-labelledby="glance-heading">
  <h2 id="glance-heading" class="sr-only">At a glance</h2>
  <div class="mx-auto flex max-w-[1600px]">
    <div class="hidden w-20 shrink-0 items-center justify-center lg:flex" aria-hidden="true">
      <VerticalLabel>At a glance</VerticalLabel>
    </div>
    <dl class="grid flex-1 grid-cols-2 lg:grid-cols-[repeat(4,1fr)_1.6fr]">
      <div class="overflow-hidden border-b border-line-dark px-6 py-8 lg:border-b-0 lg:border-l lg:px-7">
        <dt class="type-label text-vermilion" {...stripReveal(0, HERO_ENTRANCE)}>Client</dt>
        <dd {...stripReveal(0, HERO_ENTRANCE)} class="type-display mt-3 text-[clamp(1.25rem,1.5vw,1.6rem)]">{client ?? title}</dd>
      </div>
      <div class="overflow-hidden border-b border-line-dark px-6 py-8 lg:border-b-0 lg:border-l lg:px-7">
        <dt class="type-label text-vermilion" {...stripReveal(1, HERO_ENTRANCE)}>Role</dt>
        <dd {...stripReveal(1, HERO_ENTRANCE)} class="type-display mt-3 text-[clamp(1.25rem,1.5vw,1.6rem)]">{role}</dd>
      </div>
      <div class="overflow-hidden border-b border-line-dark px-6 py-8 lg:border-b-0 lg:border-l lg:px-7">
        <dt class="type-label text-vermilion" {...stripReveal(2, HERO_ENTRANCE)}>Year</dt>
        <dd {...stripReveal(2, HERO_ENTRANCE)} class="type-display mt-3 text-[clamp(1.25rem,1.5vw,1.6rem)]">{year}</dd>
      </div>
      <div class="overflow-hidden border-b border-line-dark px-6 py-8 lg:border-b-0 lg:border-l lg:px-7">
        <dt class="type-label text-vermilion" {...stripReveal(3, HERO_ENTRANCE)}>Stack</dt>
        <dd {...stripReveal(3, HERO_ENTRANCE)} class="type-label mt-3 font-medium">
          <ul role="list">
            {stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </div>
      <div class="col-span-2 overflow-hidden px-6 py-8 lg:col-span-1 lg:border-l lg:border-line-dark lg:px-7">
        <dt class="type-label text-vermilion" {...stripReveal(4, HERO_ENTRANCE)}>Result</dt>
        <dd {...stripReveal(4, HERO_ENTRANCE)} class="mt-3 text-lg leading-snug">{result}</dd>
      </div>
    </dl>
  </div>
</section>
