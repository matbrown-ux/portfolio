---
import MediaSlot from '../media/MediaSlot.astro'
import { caseStudyMedia } from '../../lib/caseStudyMedia'
import { galleryLayout } from '../../lib/galleryLayout'

interface GalleryImage {
  alt: string
  caption?: string
  src?: string
  poster?: string
  /** A video with sound waits for the visitor to press play instead of looping muted while on screen. */
  start?: 'in-view' | 'click'
}

interface Props {
  images: GalleryImage[]
  /** Below desktop width, show this gallery at the top of its chapter, above the heading. */
  lead?: boolean
}

const { images, lead = false } = Astro.props
const slug = Astro.params.slug
const layout = galleryLayout(images.length)
---

<ul role="list" class:list={['cs-block my-10 grid gap-4 px-6 md:px-12 xl:my-14', lead && 'cs-lead', layout.grid]}>
  {
    images.map((image, i) => (
      <li class:list={['group/item relative', layout.items[i].span]} data-reveal="rise" data-reveal-index={i}>
        <MediaSlot
          media={caseStudyMedia({ src: image.src, alt: image.alt, poster: image.poster }, `${slug} gallery image "${image.alt}"`)}
          tone={layout.items[i].tone}
          frame="browser"
          start={image.start}
          class="h-full"
        />
        {/* The caption sits in the browser bar, out of the picture: past the frame's 2px border, the bar's
            24px height, and in from the right by the bar's padding. */}
        {image.caption && (
          <p class="type-label absolute right-3.5 top-0.5 flex h-6 items-center text-ink">
            {image.caption}
          </p>
        )}
      </li>
    ))
  }
</ul>
