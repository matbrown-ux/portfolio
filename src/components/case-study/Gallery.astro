---
import MediaSlot from '../media/MediaSlot.astro'
import { caseStudyMedia } from '../../lib/caseStudyMedia'
import { galleryLayout } from '../../lib/galleryLayout'

interface GalleryImage {
  alt: string
  caption?: string
  src?: string
  poster?: string
}

interface Props {
  images: GalleryImage[]
}

const { images } = Astro.props
const slug = Astro.params.slug
const layout = galleryLayout(images.length)
---

<ul role="list" class:list={['cs-block my-10 grid gap-4 px-6 md:px-12 xl:my-14', layout.grid]}>
  {
    images.map((image, i) => (
      <li class:list={['group/item relative', layout.items[i].span]} data-reveal="rise" data-reveal-index={i}>
        <MediaSlot
          media={caseStudyMedia({ src: image.src, alt: image.alt, poster: image.poster }, `${slug} gallery image "${image.alt}"`)}
          tone={layout.items[i].tone}
          frame="browser"
          class="h-full"
        />
        {/* A video that has its native controls (reduced motion, or a browser that refuses autoplay)
            has its control bar along the bottom, so its caption moves to the top right, under the browser bar
            (the top left of a site capture is usually its logo). */}
        {image.caption && (
          <p class="type-label absolute bottom-3 left-3 bg-ivory px-2.5 py-1.5 text-ink group-has-[video[controls]]/item:bottom-auto group-has-[video[controls]]/item:top-10 group-has-[video[controls]]/item:left-auto group-has-[video[controls]]/item:right-3">
            {image.caption}
          </p>
        )}
      </li>
    ))
  }
</ul>
