---
import art from '../../assets/script/art.json'

interface Props {
  /** A key of src/assets/script/art.json. */
  name: keyof typeof art
  class?: string
  reveal?: 'wipe' | 'fade'
  /** Seconds. */
  delay?: number
  /** Play with the page's entrance instead of on scroll. */
  on?: 'load'
}

const { name, class: className, reveal, delay, on } = Astro.props
const { src, width, height } = art[name]
---

<img
  src={src}
  width={width}
  height={height}
  alt=""
  aria-hidden="true"
  loading="lazy"
  decoding="async"
  class:list={['pointer-events-none max-w-none select-none', className]}
  data-reveal={reveal}
  data-reveal-delay={delay}
  data-reveal-on={on}
/>
